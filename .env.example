# 邻聊不会自动读取此文件，也没有内置 dotenv。
# 前台启动需要由 shell 注入，例如：
#   set -a
#   . ./.env.example
#   set +a
#   PORT=9900 npm start
# install.sh 仅在 ~/.config/lan-chat/lan-chat.env 不存在时，把本文件复制过去。
# 用户服务通过 systemd 的 EnvironmentFile 注入，不是由 node 自行加载。
# 把占位符改成你自己的值，不要提交填写后的文件。

PORT=9900

# 不设置时，程序使用占位地址 https://chat.example.com/mcp。
# PUBLIC_MCP_URL=https://chat.example.com/mcp

# 不设置时，数据放在程序目录下的 data/。
# DATA_DIR=

# 覆盖首次生成的管理员密码。不要写入真实密码。
# ADMIN_PASSWORD=

# 上传上限（字节）。0 或不设置表示不限制。
# MAX_UPLOAD_BYTES=0

# 只在受控反向代理后面设为 1。它影响资料和限速看到的客户端地址。
# 设备门禁是否采信 X-Forwarded-For，只取决于 TCP 对端是不是本机回环，不取决于这个变量。
# TRUST_PROXY=0

# TLS_CERT_PATH=
# TLS_KEY_PATH=
# CA_CERT_PATH=
# REQUIRE_HTTPS=0

# 设备门禁默认关闭。开启后请填写你自己的网段、需要排除的基础设施地址，以及浏览器会使用的 Host。
# 未设置 DEVICE_LAN_CIDRS 时，没有任何地址被当作内网。
# DEVICE_ADMISSION_ENABLED=1
# DEVICE_LAN_CIDRS=<你的内网网段>
# DEVICE_LAN_EXCLUDED_IPS=<网关或基础设施地址>
# DEVICE_ALLOWED_HOSTS=chat.example.com
